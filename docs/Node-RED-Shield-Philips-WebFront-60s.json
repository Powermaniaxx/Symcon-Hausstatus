[
  {
    "id": "svhs_webfront_poll_tab",
    "type": "tab",
    "label": "Shield + Philips nur bei WebFront",
    "disabled": false,
    "info": "Vier bestehende poll.js Aufrufe. Diese Version ersetzt beide alten Poll-Tabs: alte Tabs nach Umstellung deaktivieren. Abfragen alle 60 Sekunden nur bei sichtbarer Hausstatus-Kachel; nach 75s ohne Ping gestoppt. Anwesenheit, Alarm und Ansagen sind nicht betroffen."
  },
  {
    "id": "svhs_poll_http_in",
    "type": "http in",
    "z": "svhs_webfront_poll_tab",
    "name": "Hausstatus ViewerPing (POST)",
    "url": "/symcon/visu-ping",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 155,
    "y": 80,
    "wires": [
      [
        "svhs_poll_receive"
      ]
    ]
  },
  {
    "id": "svhs_poll_receive",
    "type": "function",
    "z": "svhs_webfront_poll_tab",
    "name": "Ping merken · Erstaufruf sofort",
    "func": "// Heartbeat aus der Symcon-Kachel, ohne Endgeraetebefehle.\nconst now = Date.now();\nconst prev = Number(global.get('svhsViewerPingMs') || 0);\nconst newlyOnline = prev === 0 || now - prev > 75000;\nglobal.set('svhsViewerPingMs', now);\nmsg.statusCode = 200;\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {ok:true,active:true};\nreturn [msg, newlyOnline ? {payload:'webfront-open'} : null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 80,
    "wires": [
      [
        "svhs_poll_response"
      ],
      [
        "svhs_poll_wohn_start",
        "svhs_poll_ank_start",
        "svhs_poll_schlaf_start",
        "svhs_poll_tv_start"
      ]
    ]
  },
